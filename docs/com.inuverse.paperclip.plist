<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.inuverse.paperclip</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /path/to/paperclip && exec npx -y paperclipai@latest onboard --yes</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/paperclip-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/paperclip-launchd.err</string>
  <key>WorkingDirectory</key>
  <string>/path/to/paperclip</string>
</dict>
</plist>
