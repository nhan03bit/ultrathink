{
  "name": "@paperclipai/plugin-discord-transparency",
  "version": "0.1.0",
  "private": true,
  "description": "Paperclip plugin: stream meaningful events to Discord webhooks (transparency feed).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:emit": "tsx scripts/test-emit.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
