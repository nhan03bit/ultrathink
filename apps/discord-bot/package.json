{
  "name": "@inuverse/discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inuverse Discord bot (gateway client) — INU-24 doc rev 2. Out-of-process, long-lived; sibling to apps/ut-bridge and apps/cli.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json && node dist/index.js",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  }
}
